---
import ButtonLink from "@components/common/ButtonLink.astro"
import BaseLayout from "@layouts/BaseLayout.astro"
---

<!-- Bilíngue e noindex. O Cloudflare serve este arquivo com status 404 (not_found_handling: "404-page"). -->
<BaseLayout
  lang="pt"
  title="Página não encontrada | Hello World Estúdio"
  description="A página que você procurou não existe. / The page you are looking for does not exist."
  noindex
>
  <section class="mx-auto max-w-3xl px-5 py-20 text-center desk:py-28">
    <p class="font-mono text-sm text-accent">
      $ cd pagina-procurada
      <br />
      <span class="text-danger">erro 404: página não encontrada</span>
    </p>
    <h1 class="mt-6 text-[30px] font-bold tracking-[-0.02em] desk:text-[40px]">
      Essa página não existe (ou mudou de lugar).
    </h1>
    <p class="mt-3 text-soft" lang="en">
      This page does not exist (or it has moved).
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-3.5">
      <ButtonLink href="/" size="lg">
        Voltar para o início
      </ButtonLink>
      <ButtonLink href="/en/" variant="ghost" size="lg" lang="en" hreflang="en">
        English home
      </ButtonLink>
    </div>
  </section>
</BaseLayout>
