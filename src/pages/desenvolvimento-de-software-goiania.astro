---
import AreaAtendimento from "@components/sections/AreaAtendimento.astro"
import ArtigosRelacionados from "@components/sections/ArtigosRelacionados.astro"
import ComoFunciona from "@components/sections/ComoFunciona.astro"
import CtaFinal from "@components/sections/CtaFinal.astro"
import Faq from "@components/sections/Faq.astro"
import Portfolio from "@components/sections/Portfolio.astro"
import Servicos from "@components/sections/Servicos.astro"
import Sobre from "@components/sections/Sobre.astro"
import SoftwareHero from "@components/sections/SoftwareHero.astro"
import SoftwareSinais from "@components/sections/SoftwareSinais.astro"
import Tech from "@components/sections/Tech.astro"
import { softwareFaq, softwarePath, softwareSteps } from "@data/software"
import BaseLayout from "@layouts/BaseLayout.astro"
import { breadcrumbNode, serviceNode } from "@lib/seo"

// Página só PT (sem par em routes.ts): mira "desenvolvimento de software em Goiânia".
// A home fica com "criação de sites", para as duas não disputarem o mesmo termo.
const description =
  "Software sob medida, sistemas web, apps e integrações para empresas de Goiânia, Aparecida de Goiânia e Trindade. Preço fechado e orçamento no WhatsApp."
const waMessage =
  "Olá! Vi a página de desenvolvimento de software e quero conversar sobre um sistema sob medida."
---

<BaseLayout
  lang="pt"
  title="Desenvolvimento de Software em Goiânia | Hello World Estúdio"
  description={description}
  waMessage={waMessage}
  jsonLd={[
    serviceNode({
      path: softwarePath,
      name: "Desenvolvimento de software sob medida em Goiânia",
      serviceType: "Desenvolvimento de software sob medida",
      description,
    }),
    breadcrumbNode([
      { name: "Início", path: "/" },
      { name: "Desenvolvimento de software", path: softwarePath },
    ]),
  ]}
>
  <SoftwareHero message={waMessage} />
  <SoftwareSinais />
  <Servicos lang="pt" />
  <Portfolio lang="pt" />
  <ComoFunciona
    lang="pt"
    steps={softwareSteps}
    title="Do diagnóstico ao sistema em uso"
    sub="Entregas em etapas, com você testando desde as primeiras partes."
  />
  <Tech lang="pt" />
  <AreaAtendimento
    title="Desenvolvimento de software em Goiânia, Aparecida de Goiânia e Trindade"
    body="A Hello World é de Aparecida de Goiânia e desenvolve software para empresas de toda a região metropolitana de Goiânia. O atendimento é 100% online, e a manutenção do sistema continua com quem o construiu."
  />
  <Sobre lang="pt" />
  <ArtigosRelacionados />
  <Faq items={softwareFaq} title="Dúvidas sobre software sob medida" />
  <CtaFinal
    lang="pt"
    title="Vamos tirar o seu software do papel?"
    message={waMessage}
  />
</BaseLayout>
