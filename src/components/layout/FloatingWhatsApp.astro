---
import WhatsAppIcon from "@components/common/WhatsAppIcon.astro"
import { type Lang, t } from "@i18n/ui"
import { waLink } from "@lib/whatsapp"

interface Props {
  lang: Lang
  message: string
}

const { lang, message } = Astro.props
const label = t(lang).ctaWhatsApp
---

<!-- Botão flutuante em todas as telas. O BaseLayout reserva espaço no fim do body para ele não cobrir o footer.
     No desktop, o rótulo aparece ao passar o mouse ou focar pelo teclado. -->
<a
  href={waLink(message)}
  target="_blank"
  rel="noopener"
  aria-label={label}
  class="group fixed right-4 bottom-[calc(1rem+env(safe-area-inset-bottom))] z-30 flex items-center gap-3 no-underline desk:right-6 desk:bottom-6"
  data-umami-event="whatsapp_click"
  data-umami-event-placement="floating"
  data-umami-event-page={Astro.url.pathname}
>
  <span
    class="pointer-events-none hidden translate-x-2 rounded-full border border-line-strong bg-surface-2 px-4 py-2 text-sm font-semibold whitespace-nowrap text-text opacity-0 shadow-lg transition group-hover:translate-x-0 group-hover:opacity-100 group-focus-visible:translate-x-0 group-focus-visible:opacity-100 desk:block"
    aria-hidden="true"
  >
    {label}
  </span>
  <span class="flex size-14 items-center justify-center rounded-full bg-accent text-on-accent shadow-[0_10px_30px_-6px_rgba(110,231,160,.55)] transition group-hover:scale-105 group-hover:bg-accent-hover group-focus-visible:outline-2 group-focus-visible:outline-offset-4 group-focus-visible:outline-accent desk:size-[60px]">
    <WhatsAppIcon class="size-7 desk:size-[30px]" />
  </span>
</a>
