---
import Logo from "@components/common/Logo.astro"
import { site } from "@data/site"
import { homePath, routes } from "@i18n/routes"
import { type Lang, t } from "@i18n/ui"
import { waLink } from "@lib/whatsapp"

interface Props {
  lang: Lang
  waMessage: string
}

const { lang, waMessage } = Astro.props
const s = t(lang)
const year = new Date().getFullYear()
const location =
  lang === "pt"
    ? `${site.address.locality} · ${site.address.region}`
    : `${site.address.locality}, ${site.address.region}, Brazil`
---

<footer class="border-t border-line">
  <div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 desk:grid-cols-[1.4fr_1fr] desk:px-10">
    <div>
      <div class="flex items-center gap-3">
        <Logo href={homePath[lang]} small />
        <span class="text-[13.5px] text-muted">{s.footerTagline}</span>
      </div>
      <p class="mt-4 max-w-[48ch] text-sm leading-relaxed text-muted">
        {s.footerServes}
      </p>
      {s.footerLinks.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-x-5 text-sm">
          {s.footerLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="inline-flex min-h-11 items-center text-accent underline-offset-4 hover:text-accent-hover hover:underline"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <address class="text-sm leading-7 text-muted not-italic">
      <div class="font-semibold text-text">{site.name}</div>
      <div>{location}</div>
      <div>
        WhatsApp:{" "}
        <a
          href={waLink(waMessage)}
          target="_blank"
          rel="noopener"
          class="text-accent hover:text-accent-hover"
          data-umami-event="whatsapp_click"
          data-umami-event-placement="footer"
          data-umami-event-page={Astro.url.pathname}
        >
          {site.whatsapp.display}
        </a>
      </div>
      <div>
        E-mail:{" "}
        <a
          href={`mailto:${site.email}`}
          class="break-words text-accent hover:text-accent-hover"
          data-umami-event="email_click"
          data-umami-event-placement="footer"
          data-umami-event-page={Astro.url.pathname}
        >
          {site.email}
        </a>
      </div>
    </address>
  </div>

  <div class="border-t border-line-soft">
    <div class="mx-auto flex max-w-6xl flex-wrap justify-between gap-x-6 gap-y-2 px-5 py-5 font-mono text-xs leading-relaxed text-subtle desk:px-10">
      <span>
        © {year} {site.name} · CNPJ {site.cnpj}
      </span>
      <span>
        <a
          href={routes.privacy[lang]}
          class="underline-offset-4 hover:text-muted hover:underline"
        >
          {s.privacy}
        </a>{" "}
        · {s.footerRights}
      </span>
    </div>
  </div>
</footer>
