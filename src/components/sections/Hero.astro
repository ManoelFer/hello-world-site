---
import ButtonLink from "@components/common/ButtonLink.astro"
import WhatsAppButton from "@components/common/WhatsAppButton.astro"
import { type Lang, t } from "@i18n/ui"

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const pt = {
  id: "topo",
  kicker: "Criação de sites profissionais",
  h1a: "Sites que",
  sticker: "Responsivos",
  h1b: "vendem",
  h1c: "por você.",
  tagline: ["Sua ideia.", "Nosso código.", "Seu negócio no ar."],
  primary: "Pedir orçamento no WhatsApp",
  secondary: "Ver planos e preços",
  secondaryHref: "#pacotes",
  offer: "",
  note: "Atendimento 100% online, para todo o Brasil",
  scrollHint: "role para navegar",
  code: {
    fn: "criarSite",
    k1: "design",
    v1: "sob medida",
    k2: "velocidade",
    v2: "rápida",
    v3: "otimizado",
  },
  checks: [
    "Design sob medida",
    "SEO otimizado",
    "Carregamento rápido",
    "100% responsivo",
  ],
  mk: {
    pages: ["01 Início", "02 Serviços", "03 Contato"],
    nav: ["Início", "Serviços", "Projetos", "Contato"],
    btn: "Orçamento",
    kicker: "ARQUITETURA MODERNA",
    h1: "Projetos que",
    h2: "ganham vida",
    p: "Projetos residenciais e comerciais pensados para durar.",
    servKicker: "O QUE FAZEMOS",
    servTitle: "Nossos serviços",
    services: ["Residencial", "Comercial", "Interiores"],
    contactTitle: "Fale com a gente",
    send: "Enviar",
  },
}
const en: typeof pt = {
  id: "top",
  kicker: "Software studio from Brazil, since 2020",
  h1a: "From",
  sticker: "Hello, World",
  h1b: "to your product,",
  h1c: "live.",
  tagline: ["Your idea.", "Our code.", "Your product, live."],
  primary: "Start a project",
  secondary: "See what we do",
  secondaryHref: "#services",
  offer: "",
  note: "Working remotely with clients anywhere · GMT-3",
  scrollHint: "scroll to browse",
  code: {
    fn: "buildProduct",
    k1: "design",
    v1: "custom",
    k2: "speed",
    v2: "fast",
    v3: "optimized",
  },
  checks: [
    "Custom design",
    "SEO optimized",
    "Fast loading",
    "Fully responsive",
  ],
  mk: {
    pages: ["01 Home", "02 Services", "03 Contact"],
    nav: ["Home", "Services", "Work", "Contact"],
    btn: "Get quote",
    kicker: "MODERN ARCHITECTURE",
    h1: "Projects that",
    h2: "come alive",
    p: "Residential and commercial projects built to last.",
    servKicker: "WHAT WE DO",
    servTitle: "Our services",
    services: ["Residential", "Commercial", "Interiors"],
    contactTitle: "Talk to us",
    send: "Send",
  },
}
const c = { pt, en }[lang]

// Ciclo de 9s: cada tela fica 3s. Delays negativos para as três começarem já em fase.
const delays = [
  "[animation-delay:0s]",
  "[animation-delay:-6s]",
  "[animation-delay:-3s]",
]
const urls = [
  "vertice.com.br",
  "vertice.com.br/servicos",
  "vertice.com.br/contato",
]
---

<!-- Hero é o LCP: nada aqui leva data-reveal. O mockup é decorativo (aria-hidden).
     Desktop + JS + movimento liberado: scroll-scrub (seção de 270vh com o conteúdo fixo).
     Sem isso: as telas do mockup ciclam só com CSS. -->
<section
  id={c.id}
  data-hero
  class="group/h relative overflow-x-clip data-scrub:desk:h-[270vh]"
>
  <div class="relative overflow-hidden desk:sticky desk:top-0 desk:flex desk:h-svh desk:items-center">
    <div
      class="line-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(80%_70%_at_70%_40%,#000,transparent)]"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute top-[-10%] right-[-10%] aspect-square w-[60%] rounded-full bg-[radial-gradient(circle,rgb(61_255_176/.16),transparent_65%)]"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute top-[72%] left-[-10%] h-0.5 w-[150%] -rotate-[26deg] bg-linear-to-r from-transparent from-10% via-accent/80 via-60% to-transparent opacity-50 shadow-[0_0_18px_rgb(61_255_176/.6)]"
      aria-hidden="true"
    ></div>

    <div class="relative mx-auto grid max-w-7xl grid-cols-1 items-center gap-11 px-5 pt-10 pb-16 desk:grid-cols-[1fr_1.08fr] desk:w-full desk:gap-10 desk:px-12 desk:pt-24 desk:pb-10">
      <div>
        <h1 class="mb-7">
          <span class="mb-6 flex items-center gap-2.5 text-base font-medium tracking-normal text-accent">
            <span
              class="inline-flex size-[26px] items-center justify-center rounded-full bg-accent text-on-accent"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 24 24"
                class="size-4"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </span>
            {c.kicker}
          </span>
          <span class="block text-[44px] leading-[.95] font-bold tracking-[-0.045em] text-balance desk:text-[clamp(52px,min(6vw,10.5vh),96px)]">
            <span class="block">
              {c.h1a}{" "}
              <span class="inline-block -translate-y-[.12em] -rotate-6 rounded-[.25em] bg-accent px-[.5em] py-[.28em] align-middle text-[.3em] tracking-[-0.01em] text-on-accent shadow-[0_10px_30px_-8px_rgb(61_255_176/.6)]">
                {c.sticker}
              </span>
            </span>
            <span class="block text-accent [text-shadow:0_0_40px_rgb(61_255_176/.35)]">
              {c.h1b}
            </span>
            <span class="block">{c.h1c}</span>
          </span>
        </h1>
        <p class="mb-7 text-lg leading-normal text-soft italic desk:text-[19px]">
          {c.tagline.map((line, i) => (
            <span
              class:list={["block", i === c.tagline.length - 1 && "text-text"]}
            >
              {line}
            </span>
          ))}
        </p>
        {c.offer && (
          <p class="mb-7 font-mono text-sm font-semibold text-accent">
            {c.offer}
          </p>
        )}
        <div class="flex flex-wrap gap-3">
          <WhatsAppButton
            size="lg"
            arrow
            message={t(lang).waDefault}
            placement="hero"
            label={c.primary}
            class="rounded-full shadow-[0_14px_40px_-14px_rgb(61_255_176/.7)]"
          />
          <ButtonLink
            variant="ghost"
            size="lg"
            href={c.secondaryHref}
            class="rounded-full"
          >
            {c.secondary}
          </ButtonLink>
        </div>
        <p class="mt-6 flex items-center gap-2 font-mono text-[12.5px] text-label">
          <svg
            viewBox="0 0 24 24"
            class="size-4 flex-none text-accent"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z" />
            <circle cx="12" cy="9.5" r="2.5" />
          </svg>
          {c.note}
        </p>
        <div
          class="mt-8 hidden flex-wrap items-center gap-4 font-mono text-xs text-subtle group-data-scrub/h:desk:flex"
          aria-hidden="true"
        >
          {c.mk.pages.map((pg, i) => (
            <span
              data-ind={i}
              class="flex items-center gap-2 transition-colors duration-400"
            >
              <span
                data-indbar
                class="h-0.5 w-[22px] bg-accent/20 transition-[width,background-color] duration-400"
              ></span>
              {pg}
            </span>
          ))}
          <span>· {c.scrollHint}</span>
        </div>
      </div>

      <div class="relative" aria-hidden="true">
        <div class="@container relative aspect-[1.12/1] w-full [perspective:1700px]">
          <div
            data-hw="browser"
            class="absolute top-[13%] left-[2%] w-[84%] will-change-transform motion-safe:transition-transform motion-safe:duration-250 motion-safe:ease-out overflow-hidden rounded-[2.2cqi] border border-accent/25 bg-surface-2 shadow-[0_50px_120px_-40px_rgb(0_0_0/.95),0_0_80px_-30px_rgb(61_255_176/.35)] desk:[transform:rotateX(9deg)_rotateY(-14deg)_rotateZ(1deg)]"
          >
            <div class="flex items-center gap-[1.2cqi] border-b border-line bg-[#0d1412] px-[2cqi] py-[1.6cqi]">
              <span class="size-[1.5cqi] rounded-full bg-danger"></span>
              <span class="size-[1.5cqi] rounded-full bg-warn"></span>
              <span class="size-[1.5cqi] rounded-full bg-accent"></span>
              <span class="ml-[1.5cqi] grid flex-1 rounded-full bg-accent/7 px-[1.8cqi] py-[.7cqi] font-mono text-[1.5cqi] text-label">
                {urls.map((u, i) => (
                  <span
                    data-url={i}
                    class:list={[
                      "[grid-area:1/1] animate-hw-page transition-opacity duration-400 group-data-scrub/h:animate-none motion-reduce:animate-none",
                      delays[i],
                      i > 0 && "opacity-0",
                    ]}
                  >
                    {u}
                  </span>
                ))}
              </span>
            </div>
            <div class="@container relative aspect-[16/10.4] bg-[#090d0c]">
              <div class="flex items-center justify-between px-[3.4cqi] py-[2.4cqi]">
                <span class="flex items-center gap-[1cqi] text-[2.1cqi] font-bold tracking-[.16em]">
                  <span class="size-[1.8cqi] rotate-45 bg-accent"></span>VÉRTICE
                </span>
                <span class="flex gap-[2.6cqi] text-[1.5cqi] text-label">
                  {c.mk.nav.map((n) => (
                    <span>{n}</span>
                  ))}
                </span>
                <span class="rounded-full bg-accent px-[1.8cqi] py-[.9cqi] text-[1.4cqi] font-bold text-on-accent">
                  {c.mk.btn} →
                </span>
              </div>
              <div class="absolute inset-[9cqi_0_0_0]">
                <div
                  data-page="0"
                  class:list={[
                    "absolute inset-0 grid grid-cols-[1fr_1.05fr] gap-[3cqi] px-[3.4cqi] pt-[1cqi] pb-[3.4cqi] animate-hw-page transition-[opacity,transform] duration-500 group-data-scrub/h:animate-none motion-reduce:animate-none",
                    delays[0],
                  ]}
                >
                  <div class="flex flex-col justify-center gap-[1.8cqi]">
                    <span class="text-[1.3cqi] font-semibold tracking-[.2em] text-accent">
                      {c.mk.kicker}
                    </span>
                    <span class="text-[5.4cqi] leading-[1.02] font-bold tracking-[-0.03em]">
                      {c.mk.h1} <span class="text-accent">{c.mk.h2}</span>
                    </span>
                    <span class="text-[1.6cqi] leading-normal text-muted">
                      {c.mk.p}
                    </span>
                    <span class="self-start rounded-full bg-accent px-[2.2cqi] py-[1.1cqi] text-[1.5cqi] font-bold text-on-accent">
                      {c.mk.btn} →
                    </span>
                  </div>
                  <div class="relative overflow-hidden rounded-[1.8cqi] bg-linear-170 from-[#1b2622] to-[#0c1210] to-70%">
                    <div class="absolute right-[-10%] bottom-0 left-[-10%] h-[30%] bg-[radial-gradient(60%_100%_at_50%_100%,rgb(61_255_176/.35),transparent)]"></div>
                    <div class="absolute bottom-[12%] left-[14%] grid h-[30%] w-[58%] grid-cols-4 gap-[6%] border-t-2 border-accent/60 bg-[#202d29] p-[5%]">
                      <span class="bg-accent/70"></span>
                      <span class="bg-[#2b3a35]"></span>
                      <span class="bg-accent/45"></span>
                      <span class="bg-[#2b3a35]"></span>
                    </div>
                    <div class="absolute bottom-[42%] left-[30%] grid h-[24%] w-[56%] grid-cols-3 gap-[6%] border-t-2 border-accent/60 bg-[#26352f] p-[5%]">
                      <span class="bg-[#33443e]"></span>
                      <span class="bg-accent/60"></span>
                      <span class="bg-[#33443e]"></span>
                    </div>
                    <div class="absolute right-0 bottom-0 left-0 h-[12%] bg-surface-2"></div>
                  </div>
                </div>
                <div
                  data-page="1"
                  class:list={[
                    "absolute inset-0 flex flex-col gap-[2.4cqi] px-[3.4cqi] pt-[1cqi] pb-[3.4cqi] opacity-0 animate-hw-page transition-[opacity,transform] duration-500 group-data-scrub/h:animate-none motion-reduce:animate-none",
                    delays[1],
                  ]}
                >
                  <span class="text-[1.3cqi] font-semibold tracking-[.2em] text-accent">
                    {c.mk.servKicker}
                  </span>
                  <span class="text-[4.4cqi] font-bold tracking-[-0.03em]">
                    {c.mk.servTitle}
                  </span>
                  <div class="grid flex-1 grid-cols-3 gap-[2cqi]">
                    {c.mk.services.map((s) => (
                      <div class="flex flex-col gap-[1.4cqi] rounded-[1.6cqi] border border-accent/14 bg-[#0f1714] p-[2.2cqi]">
                        <span class="size-[4cqi] rounded-[1cqi] border border-accent/50 bg-accent/16"></span>
                        <span class="text-[1.9cqi] font-semibold">{s}</span>
                        <span class="h-[.9cqi] w-[90%] rounded-[1cqi] bg-text/12"></span>
                        <span class="h-[.9cqi] w-[65%] rounded-[1cqi] bg-text/12"></span>
                      </div>
                    ))}
                  </div>
                </div>
                <div
                  data-page="2"
                  class:list={[
                    "absolute inset-0 grid grid-cols-2 gap-[3cqi] px-[3.4cqi] pt-[1cqi] pb-[3.4cqi] opacity-0 animate-hw-page transition-[opacity,transform] duration-500 group-data-scrub/h:animate-none motion-reduce:animate-none",
                    delays[2],
                  ]}
                >
                  <div class="flex flex-col gap-[1.5cqi]">
                    <span class="text-[4.4cqi] leading-[1.05] font-bold tracking-[-0.03em]">
                      {c.mk.contactTitle}
                    </span>
                    <span class="h-[4.4cqi] rounded-[1cqi] border border-accent/20 bg-[#0f1714]"></span>
                    <span class="h-[4.4cqi] rounded-[1cqi] border border-accent/20 bg-[#0f1714]"></span>
                    <span class="flex-1 rounded-[1cqi] border border-accent/20 bg-[#0f1714]"></span>
                    <span class="self-start rounded-full bg-accent px-[2.4cqi] py-[1.1cqi] text-[1.5cqi] font-bold text-on-accent">
                      {c.mk.send} →
                    </span>
                  </div>
                  <div class="relative overflow-hidden rounded-[1.8cqi] bg-[#0e1513] bg-[linear-gradient(rgb(61_255_176/.08)_1px,transparent_1px),linear-gradient(90deg,rgb(61_255_176/.08)_1px,transparent_1px)] bg-size-[3cqi_3cqi]">
                    <span class="absolute top-[42%] left-[52%] size-[3cqi] rounded-full bg-accent shadow-[0_0_0_1.6cqi_rgb(61_255_176/.2),0_0_30px_rgb(61_255_176/.8)]"></span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div
            data-hw="code"
            class="absolute top-0 right-0 w-[43%] motion-safe:transition-transform motion-safe:duration-250 motion-safe:ease-out overflow-hidden rounded-[1.8cqi] border border-accent/25 bg-surface-2/92 font-mono text-[max(8px,1.7cqi)] leading-[1.75] shadow-[0_30px_70px_-30px_rgb(0_0_0/.95)] backdrop-blur-sm"
          >
            <div class="flex items-center gap-[.9cqi] border-b border-line px-[1.6cqi] py-[1.2cqi]">
              <span class="size-[1.1cqi] rounded-full bg-danger"></span>
              <span class="size-[1.1cqi] rounded-full bg-warn"></span>
              <span class="size-[1.1cqi] rounded-full bg-accent"></span>
              <span class="ml-[1cqi] text-label">site.js</span>
            </div>
            <div class="px-[2cqi] py-[1.6cqi] whitespace-pre text-soft">
              <div>
                <span class="text-subtle">1 </span>
                <span class="text-accent">function</span> {c.code.fn}() {"{"}
              </div>
              <div>
                <span class="text-subtle">2 </span>{" "}
                <span class="text-accent">return</span> {"{"}
              </div>
              <div>
                <span class="text-subtle">3 </span> {c.code.k1}:{" "}
                <span class="text-warn">'{c.code.v1}'</span>,
              </div>
              <div>
                <span class="text-subtle">4 </span> {c.code.k2}:{" "}
                <span class="text-warn">'{c.code.v2}'</span>,
              </div>
              <div>
                <span class="text-subtle">5 </span> seo:{" "}
                <span class="text-warn">'{c.code.v3}'</span>,
              </div>
              <div>
                <span class="text-subtle">6 </span> {"}"};
              </div>
              <div>
                <span class="text-subtle">7 </span>
                {"}"}
                <span class="ml-1 inline-block h-[1.1em] w-[.8em] animate-blink bg-accent align-[-.2em] motion-reduce:animate-none"></span>
              </div>
            </div>
          </div>

          <div
            data-hw="check"
            class="absolute bottom-[5%] left-[-1%] flex w-[37%] animate-float group-data-scrub/h:animate-none motion-safe:transition-transform motion-safe:duration-250 motion-safe:ease-out flex-col gap-[1.4cqi] rounded-[2cqi] border border-accent/25 bg-surface-2/90 p-[2.2cqi] shadow-[0_30px_70px_-30px_rgb(0_0_0/.95)] backdrop-blur-md motion-reduce:animate-none"
          >
            <span class="font-mono text-[max(8px,1.5cqi)] text-accent">
              &gt;_ hello.world
            </span>
            {c.checks.map((ck, i) => (
              <div class="flex items-center justify-between gap-[1cqi] text-[max(9px,1.85cqi)] text-point">
                <span>{ck}</span>
                <span
                  data-chk={i}
                  class="inline-flex size-[2.6cqi] flex-none items-center justify-center rounded-full border border-accent/40 bg-accent transition-[background-color,box-shadow] duration-300 text-[1.6cqi] font-bold text-on-accent shadow-[0_0_12px_rgb(61_255_176/.6)]"
                >
                  ✓
                </span>
              </div>
            ))}
          </div>

          <div
            data-hw="phone"
            class="absolute right-[3%] bottom-[-1%] aspect-[9/18.5] w-[21%] animate-float group-data-scrub/h:animate-none motion-safe:transition-transform motion-safe:duration-250 motion-safe:ease-out rounded-[3.4cqi] border border-accent/30 bg-[#121917] p-[.9cqi] shadow-[0_34px_70px_-24px_rgb(0_0_0/.95),0_0_40px_-16px_rgb(61_255_176/.4)] [animation-delay:-3s] motion-reduce:animate-none"
          >
            <div class="flex size-full flex-col gap-[1.3cqi] overflow-hidden rounded-[2.6cqi] bg-[#090d0c] px-[1.5cqi] py-[1.6cqi]">
              <div class="flex justify-center">
                <span class="h-[1.2cqi] w-[6cqi] rounded-[1cqi] bg-[#1d2724]"></span>
              </div>
              <span class="text-[1.25cqi] font-bold tracking-[.14em]">
                VÉRTICE
              </span>
              <span class="text-[2.1cqi] leading-[1.05] font-bold tracking-[-0.02em]">
                {c.mk.h1} <span class="text-accent">{c.mk.h2}</span>
              </span>
              <span class="self-start rounded-full bg-accent px-[1.3cqi] py-[.7cqi] text-[1cqi] font-bold text-on-accent">
                {c.mk.btn} →
              </span>
              <div class="relative flex-1 overflow-hidden rounded-[1.4cqi] bg-linear-170 from-[#1b2622] to-[#0c1210]">
                <div class="absolute bottom-[14%] left-[12%] h-[34%] w-[70%] border-t-2 border-accent/60 bg-[#202d29]"></div>
                <div class="absolute right-0 bottom-0 left-0 h-[30%] bg-[radial-gradient(70%_100%_at_50%_100%,rgb(61_255_176/.35),transparent)]"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Scroll-scrub do hero (visual v2 original). Só no desktop e com movimento liberado.
  const hero = document.querySelector<HTMLElement>("[data-hero]")
  const desk = window.matchMedia("(min-width: 801px)")
  const still = window.matchMedia("(prefers-reduced-motion: reduce)")
  if (hero) {
    const q = <T extends HTMLElement>(s: string) => hero.querySelector<T>(s)
    const qa = (s: string) => [...hero.querySelectorAll<HTMLElement>(s)]
    const [browser, code, phone, check] = [
      "browser",
      "code",
      "phone",
      "check",
    ].map((k) => q(`[data-hw="${k}"]`))
    const pages = qa("[data-page]")
    const urls = qa("[data-url]")
    const inds = qa("[data-ind]")
    const chks = qa("[data-chk]")
    let ticking = false

    const reset = () => {
      delete hero.dataset.scrub
      for (const el of [
        browser,
        code,
        phone,
        check,
        ...pages,
        ...urls,
        ...chks,
      ])
        el?.removeAttribute("style")
    }
    const update = () => {
      ticking = false
      if (!hero.dataset.scrub) return
      const total = hero.offsetHeight - window.innerHeight
      const p =
        total > 0
          ? Math.max(0, Math.min(1, -hero.getBoundingClientRect().top / total))
          : 0
      const page = Math.min(2, Math.floor(p * 3))
      if (browser)
        browser.style.transform = `rotateX(${14 - 11 * p}deg) rotateY(${-24 + 32 * p}deg) rotateZ(${2 - 2.5 * p}deg) scale(${1 + 0.04 * p})`
      if (code)
        code.style.transform = `translate3d(${20 - 30 * p}px, ${-10 - 40 * p}px, 0)`
      if (phone)
        phone.style.transform = `translate3d(0, ${50 - 80 * p}px, 0) rotate(${6 - 8 * p}deg)`
      if (check)
        check.style.transform = `translate3d(${-20 + 30 * p}px, ${30 - 50 * p}px, 0)`
      pages.forEach((el, i) => {
        el.style.opacity = i === page ? "1" : "0"
        el.style.transform = i === page ? "none" : "translateY(4%)"
      })
      urls.forEach((el, i) => (el.style.opacity = i === page ? "1" : "0"))
      inds.forEach((el, i) => {
        const on = i === page
        el.style.color = on ? "var(--color-text)" : ""
        const bar = el.querySelector<HTMLElement>("[data-indbar]")
        if (bar) {
          bar.style.width = on ? "36px" : ""
          bar.style.backgroundColor = on ? "var(--color-accent)" : ""
        }
      })
      chks.forEach((el, i) => {
        const on = p > i / 4.4
        el.style.backgroundColor = on ? "" : "transparent"
        el.style.boxShadow = on ? "" : "none"
      })
    }
    const onScroll = () => {
      if (!ticking) {
        ticking = true
        requestAnimationFrame(update)
      }
    }
    const setup = () => {
      if (desk.matches && !still.matches) hero.dataset.scrub = "on"
      else reset()
      update()
    }
    window.addEventListener("scroll", onScroll, { passive: true })
    window.addEventListener("resize", onScroll)
    desk.addEventListener("change", setup)
    still.addEventListener("change", setup)
    setup()
  }
</script>
