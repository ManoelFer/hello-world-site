---
import { Image } from "astro:assets"

import foto from "@assets/manoel-fernandes-fundador.png"
import Section from "@components/common/Section.astro"
import { credentials } from "@data/credenciais"
import { site } from "@data/site"
import type { Lang } from "@i18n/ui"

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const pt = {
  id: "sobre",
  kicker: "sobre",
  title: "Gostamos de resolver problemas com código.",
  body: "A Hello World nasceu em 2020 com uma ideia simples: transformar boas ideias em software que funciona. Hoje, de Aparecida de Goiânia (GO), trabalhamos 100% online e lado a lado com o cliente, do primeiro rascunho ao que vai pro ar, com clareza, qualidade e prazos honestos.",
  points: [
    "Comunicação direta, sem juridiquês nem enrolação",
    "Código limpo, testado e sustentável",
    "Entregas em prazos honestos e previsíveis",
  ],
  credentialsTitle: `Formação e certificações de ${site.founder.name}, fundador`,
  verify: "Verificar no Credly",
  newTab: "(abre em nova aba)",
  role: "Fundador e desenvolvedor",
  categories: { degree: "Graduação", certificate: "Certificação" },
  photoAlt: `${site.founder.name}, fundador da Hello World Estúdio, de terno, olhando para o lado`,
}
const en: typeof pt = {
  id: "about",
  kicker: "about",
  title: "People who like solving problems with code.",
  body: "Hello World started in 2020 with a simple idea: turn good ideas into software that works. Based in Aparecida de Goiânia, Brazil, we work fully online and side by side with our clients, from the first sketch to production, with clarity, quality and honest deadlines.",
  points: [
    "Direct communication, no jargon, no runaround",
    "Clean, tested, maintainable code",
    "Honest, predictable delivery dates",
  ],
  credentialsTitle: `Education and certifications of ${site.founder.name}, founder`,
  verify: "Verify on Credly",
  newTab: "(opens in a new tab)",
  role: "Founder and developer",
  categories: { degree: "Degree", certificate: "Certification" },
  photoAlt: `${site.founder.name}, founder of Hello World Estúdio, wearing a suit and looking to the side`,
}
const c = { pt, en }[lang]
---

<Section
  id={c.id}
  border
  class="overflow-x-clip"
  innerClass="grid gap-x-14 gap-y-10 py-14 desk:grid-cols-[5fr_7fr] desk:grid-rows-[1fr_auto] desk:py-[82px]"
>
  <div class="desk:col-start-2 desk:row-start-1">
    <p class="mb-3.5 font-mono text-[13px] text-accent">// {c.kicker}</p>
    <h2
      data-reveal
      class="mb-6 text-[34px] leading-[1.05] font-bold tracking-[-0.03em] text-balance desk:text-[clamp(44px,4.6vw,60px)]"
    >
      {c.title}
    </h2>
    <p class="max-w-[640px] text-[16.5px] leading-[1.72] text-soft desk:text-lg">
      {c.body}
    </p>
  </div>

  <article
    data-reveal
    class="relative overflow-hidden rounded-3xl border border-line bg-surface-2 desk:col-start-1 desk:row-span-2 desk:row-start-1"
  >
    <div class="relative h-[400px] overflow-hidden desk:h-[440px]">
      <div
        class="pointer-events-none absolute top-0 left-1/2 aspect-square w-[110%] -translate-x-1/2 bg-[radial-gradient(closest-side,rgb(61_255_176/.17),rgb(61_255_176/.1)_30%,rgb(61_255_176/.035)_60%,rgb(61_255_176/.01)_85%,transparent)]"
        aria-hidden="true"
      ></div>
      <div
        class="line-grid pointer-events-none absolute inset-0 opacity-40 [mask-image:radial-gradient(closest-side,#000,transparent)]"
        aria-hidden="true"
      ></div>
      <Image
        src={foto}
        alt={c.photoAlt}
        widths={[330, 660]}
        sizes="330px"
        format="webp"
        class="relative mx-auto mt-6 h-[520px] w-auto max-w-none [mask-image:linear-gradient(to_bottom,#000_52%,transparent_76%)] [filter:drop-shadow(0_24px_30px_rgb(0_0_0/.6))_drop-shadow(0_0_28px_rgb(61_255_176/.08))]"
      />
    </div>
    <div class="relative px-6 pt-1 pb-6 desk:px-8 desk:pb-8">
      <p class="text-2xl leading-tight font-semibold text-point">
        {site.founder.name}
      </p>
      <p class="mt-1.5 font-mono text-sm text-accent">{c.role}</p>
      <h3 class="sr-only">{c.credentialsTitle}</h3>
      <ul class="mt-6 border-t border-line-soft">
        {credentials.map((cred) => (
          <li class="border-b border-line-soft py-4 last:border-b-0 last:pb-0">
            <div class="flex items-start justify-between gap-4">
              <p class="text-[15.5px] leading-snug font-semibold text-point">
                {cred.name[lang]}
              </p>
              <span class="mt-0.5 flex-none font-mono text-[11px] tracking-[.12em] text-label uppercase">
                {c.categories[cred.category]}
              </span>
            </div>
            <p class="mt-1 text-sm text-muted">
              {`${cred.issuer.name} · ${cred.year}`}
            </p>
            {cred.verifyUrl && (
              <a
                href={cred.verifyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 items-center gap-1.5 text-[15px] font-semibold text-accent hover:text-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
              >
                <span>
                  {c.verify}
                  <span class="sr-only">
                    {`: ${cred.name[lang]} ${c.newTab}`}
                  </span>
                </span>
                <span aria-hidden="true">↗</span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </article>

  <ol data-reveal class="desk:col-start-2 desk:row-start-2">
    {c.points.map((point, i) => (
      <li class="flex items-center gap-6 border-t border-line-soft py-5 last:border-b desk:gap-9">
        <span class="font-mono text-sm text-accent" aria-hidden="true">
          {String(i + 1).padStart(2, "0")}
        </span>
        <span class="text-lg leading-snug text-point desk:text-xl">
          {point}
        </span>
      </li>
    ))}
  </ol>
</Section>
