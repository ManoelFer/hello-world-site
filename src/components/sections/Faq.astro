---
import Section from "@components/common/Section.astro"
import SectionHeading from "@components/common/SectionHeading.astro"
import { faq, type FaqItem } from "@data/faq"

interface Props {
  /** Perguntas desta página; por padrão, as da home. */
  items?: FaqItem[]
  title?: string
}

const { items = faq, title = "Dúvidas comuns antes de começar" } = Astro.props
---

<!-- <details name="faq">: acordeão exclusivo sem JS. -->
<Section id="faq" border>
  <SectionHeading kicker="perguntas frequentes" title={title} />
  <div class="flex max-w-3xl flex-col gap-3">
    {items.map((item) => (
      <details
        name="faq"
        data-reveal
        class="group rounded-[14px] border border-line bg-surface-2 open:border-accent/35"
      >
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-6 py-5 text-[17px] font-semibold [&::-webkit-details-marker]:hidden">
          <span>{item.q}</span>
          <span
            class="font-mono text-xl text-accent transition-transform group-open:rotate-45"
            aria-hidden="true"
          >
            +
          </span>
        </summary>
        <p class="px-6 pb-6 text-[15.5px] leading-[1.7] text-soft">{item.a}</p>
      </details>
    ))}
  </div>
</Section>
