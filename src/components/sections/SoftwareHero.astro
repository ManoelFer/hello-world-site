---
import ButtonLink from "@components/common/ButtonLink.astro"
import WhatsAppButton from "@components/common/WhatsAppButton.astro"

interface Props {
  /** Mensagem do WhatsApp desta página. */
  message: string
}

const { message } = Astro.props
---

<!-- Hero é o LCP: nada aqui leva data-reveal. -->
<section id="topo" class="relative overflow-hidden">
  <div
    class="dot-grid pointer-events-none absolute inset-0"
    aria-hidden="true"
  ></div>
  <div class="relative mx-auto max-w-6xl px-5 pt-7 pb-[52px] desk:px-10 desk:pt-12 desk:pb-[78px]">
    <!-- Mesma trilha do BreadcrumbList no JSON-LD da página. -->
    <nav
      aria-label="Você está em"
      class="mb-8 font-mono text-[12.5px] text-label"
    >
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a
            href="/"
            class="inline-flex min-h-11 items-center hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            Início
          </a>
        </li>
        <li aria-hidden="true">›</li>
        <li aria-current="page" class="text-muted">
          Desenvolvimento de software
        </li>
      </ol>
    </nav>
    <p class="mb-[26px] inline-flex items-center gap-[9px] rounded-full border border-accent/20 bg-accent/8 px-[13px] py-[7px] font-mono text-[12.5px] text-accent">
      <span
        class="size-[7px] rounded-full bg-accent shadow-[0_0_9px_var(--color-accent)]"
        aria-hidden="true"
      ></span>
      Software house em Aparecida de Goiânia, desde 2020
    </p>
    <h1 class="mb-[22px] max-w-[22ch] text-[34px] leading-[1.08] font-bold tracking-[-0.025em] desk:text-[52px] desk:leading-[1.05]">
      Desenvolvimento de software sob medida em{" "}
      <span class="text-accent">Goiânia</span> e região
    </h1>
    <p class="mb-5 max-w-[60ch] text-[17px] leading-[1.62] text-soft desk:text-lg">
      A Hello World desenvolve sistemas web, aplicativos para Android e iPhone,
      APIs e integrações para empresas de Goiânia, Aparecida de Goiânia e
      Trindade. O software é construído em volta do seu processo, e não o
      contrário, com preço fechado e conversa direta com quem programa.
    </p>
    <p class="mb-[34px] max-w-[60ch] text-base leading-[1.62] text-muted">
      O atendimento é 100% online, pelo WhatsApp e por videochamada. Do
      diagnóstico à primeira versão em uso, você acompanha cada etapa.
    </p>
    <div class="flex flex-wrap gap-3.5">
      <WhatsAppButton
        size="lg"
        arrow
        message={message}
        placement="software-hero"
        label="Conversar no WhatsApp"
      />
      <ButtonLink variant="ghost" size="lg" href="#servicos">
        Ver serviços
      </ButtonLink>
    </div>
  </div>
</section>
