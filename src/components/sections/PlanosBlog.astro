---
import Section from "@components/common/Section.astro"
import SectionHeading from "@components/common/SectionHeading.astro"
import WhatsAppButton from "@components/common/WhatsAppButton.astro"
import {
  blogAnualPorMes,
  blogCancelamento,
  blogCobranca,
  blogTodosIncluem,
  planosBlog,
} from "@data/packages"
import { brl } from "@lib/format"
---

<Section id="blog" border>
  <SectionHeading
    kicker="blog para o seu site"
    title="Blog com painel próprio, sem código"
    sub="Escreva e publique artigos no site que o estúdio mantém para você, sem Markdown e sem código. Contratação mensal ou anual, combinada pelo WhatsApp."
  />
  <div class="grid gap-[18px] desk:grid-cols-2">
    {planosBlog.map((p) => (
      <div data-reveal class="rounded-2xl border border-line bg-surface-2 p-7">
        <h3 class="text-lg font-bold">{p.nome}</h3>
        <p class="mt-3">
          <span class="block font-mono text-xs text-label uppercase">
            mensal
          </span>
          <span class="font-mono text-[26px] font-bold">{brl(p.mensal)}</span>
          <span class="font-mono text-xs text-label">/mês</span>
        </p>
        <p class="mt-1 font-mono text-xs text-accent">
          {`ou ${brl(p.anual)} por ano (cerca de ${brl(blogAnualPorMes(p))}/mês)`}
        </p>
        <ul class="mt-4 flex flex-col gap-2 text-[15.5px] leading-relaxed text-soft">
          {p.inclui.map((item) => (
            <li class="flex gap-3">
              <span class="font-mono text-accent" aria-hidden="true">
                ✓
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <WhatsAppButton
          class="mt-5 w-full"
          variant="ghost"
          message={p.msgWhatsApp}
          placement={`precos-${p.nome.toLowerCase().replace(" ", "-")}`}
          label="Quero este"
        />
      </div>
    ))}
  </div>
  <p data-reveal class="mt-4 text-[15px] leading-relaxed text-soft">
    No plano anual você paga 10 meses e usa 12: são 2 meses grátis.
  </p>

  <div class="mt-12 grid gap-10 desk:grid-cols-3">
    <div data-reveal>
      <h3 class="text-xl font-bold">Todos os planos incluem</h3>
      <ul class="mt-4 flex flex-col gap-3 text-[15.5px] leading-relaxed text-soft">
        {blogTodosIncluem.map((item) => (
          <li class="flex gap-3">
            <span class="font-mono text-accent" aria-hidden="true">
              ✓
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
    <div data-reveal>
      <h3 class="text-xl font-bold">Como funciona a cobrança</h3>
      <ul class="mt-4 flex flex-col gap-3 text-[15.5px] leading-relaxed text-soft">
        {blogCobranca.map((item) => (
          <li class="flex gap-3">
            <span class="font-mono text-accent" aria-hidden="true">
              ›
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
    <div data-reveal>
      <h3 class="text-xl font-bold">Cancelamento e vencimento</h3>
      <ul class="mt-4 flex flex-col gap-3 text-[15.5px] leading-relaxed text-soft">
        {blogCancelamento.map((item) => (
          <li class="flex gap-3">
            <span class="font-mono text-accent" aria-hidden="true">
              ›
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>
