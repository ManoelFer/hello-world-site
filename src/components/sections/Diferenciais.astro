---
// Faixa logo abaixo do hero (visual v2). Só PT: a home EN usa Stats.
const items = [
  {
    g: "»",
    t: "Rápido de verdade",
    d: "Processo enxuto e comunicação direta: sem burocracia entre a ideia e o site no ar.",
  },
  {
    g: "R$",
    t: "Preço fechado",
    d: "Você sabe quanto vai pagar antes de começar. Sem cobrança por hora nem surpresa no fim.",
  },
  {
    g: "BR",
    t: "Para todo o Brasil",
    d: "Atendimento 100% online, pelo WhatsApp e por videochamada. Onde você estiver, o processo é o mesmo.",
  },
  {
    g: "</>",
    t: "Feito sob medida",
    d: "Layout e textos pensados para o seu negócio e o seu público-alvo.",
  },
]
---

<section id="diferenciais" class="border-y border-line bg-bg">
  <h2 class="sr-only">Diferenciais</h2>
  <ul class="mx-auto grid max-w-7xl sm:grid-cols-2 desk:grid-cols-4 desk:px-12">
    {items.map((item) => (
      <li
        data-reveal
        class="flex items-start gap-4 border-b border-line-soft px-5 py-7 last:border-b-0 sm:[&:nth-last-child(-n+2)]:border-b-0 desk:border-r desk:border-b-0 desk:px-6 desk:last:border-r-0"
      >
        <span
          class="inline-flex size-[46px] flex-none items-center justify-center rounded-full border-[1.5px] border-accent font-mono text-sm font-bold text-accent"
          aria-hidden="true"
        >
          {item.g}
        </span>
        <div>
          <h3 class="mb-1.5 text-base leading-tight font-semibold">{item.t}</h3>
          <p class="text-[14px] leading-relaxed text-muted">{item.d}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
