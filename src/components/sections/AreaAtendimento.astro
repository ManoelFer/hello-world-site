---
import Section from "@components/common/Section.astro"
import { site } from "@data/site"

interface Props {
  title?: string
  body?: string
}

const {
  title = "Atendimento online para todo o Brasil",
  body = "Você não precisa estar na mesma cidade que a gente. Toda a conversa, do orçamento à entrega, acontece pelo WhatsApp e por videochamada, e o suporte continua com quem construiu o site.",
} = Astro.props

const itens = [
  "Conversa e orçamento pelo WhatsApp",
  "Reuniões por videochamada",
  "Pagamento por Pix ou cartão",
  "Suporte direto com quem desenvolve",
]
---

<Section
  id="atendimento"
  border
  innerClass="grid gap-[30px] py-14 desk:grid-cols-2 desk:gap-14 desk:py-[82px]"
>
  <div>
    <p class="mb-3.5 font-mono text-[13px] text-accent">
      // área de atendimento
    </p>
    <h2
      data-reveal
      class="mb-[22px] text-[26px] leading-[1.15] font-bold tracking-[-0.02em] desk:text-[33px]"
    >
      {title}
    </h2>
    <p class="text-[16.5px] leading-[1.72] text-soft">{body}</p>
  </div>
  <div
    data-reveal
    class="self-center rounded-2xl border border-line bg-surface-2 px-[30px] py-8"
  >
    <ul>
      {itens.map((item) => (
        <li class="flex items-center gap-3.5 border-b border-line-soft py-3.5">
          <span class="font-mono text-accent" aria-hidden="true">
            ›
          </span>
          <span class="text-[17px] font-semibold">{item}</span>
        </li>
      ))}
      <li class="flex items-center gap-3.5 py-3.5 text-muted">
        <span class="font-mono text-accent" aria-hidden="true">
          +
        </span>
        <span>
          Estúdio com base em {site.address.locality}, {site.address.region}
        </span>
      </li>
    </ul>
  </div>
</Section>
