---
import Section from "@components/common/Section.astro"
import { cities, site } from "@data/site"
---

<Section
  id="atendimento"
  border
  innerClass="grid gap-[30px] py-14 desk:grid-cols-2 desk:gap-14 desk:py-[82px]"
>
  <div>
    <p class="mb-3.5 font-mono text-[13px] text-accent">
      // área de atendimento
    </p>
    <h2
      data-reveal
      class="mb-[22px] text-[26px] leading-[1.15] font-bold tracking-[-0.02em] desk:text-[33px]"
    >
      Criação de sites em Goiânia, Aparecida de Goiânia e Trindade
    </h2>
    <p class="text-[16.5px] leading-[1.72] text-soft">
      A Hello World é de Aparecida de Goiânia e atende empresas de toda a região
      metropolitana de Goiânia. O atendimento é 100% online. O suporte continua
      com quem construiu o site.
    </p>
  </div>
  <div
    data-reveal
    class="self-center rounded-2xl border border-line bg-surface-2 px-[30px] py-8"
  >
    <ul>
      {cities.map((city) => (
        <li class="flex items-center gap-3.5 border-b border-line-soft py-3.5">
          <span class="font-mono text-accent" aria-hidden="true">
            ›
          </span>
          <span class="text-[17px] font-semibold">{city.name}</span>
          {city.name === site.address.locality ? (
            <span class="ml-auto rounded-full border border-accent/30 px-2.5 py-0.5 font-mono text-xs text-accent">
              base
            </span>
          ) : (
            <span class="ml-auto font-mono text-xs text-label">GO</span>
          )}
        </li>
      ))}
      <li class="flex items-center gap-3.5 py-3.5 text-muted">
        <span class="font-mono text-accent" aria-hidden="true">
          +
        </span>
        <span>e toda a região metropolitana</span>
      </li>
    </ul>
  </div>
</Section>
