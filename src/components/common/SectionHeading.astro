---
interface Props {
  kicker: string
  title: string
  sub?: string
}

const { kicker, title, sub } = Astro.props
---

<div class="mb-10 desk:mb-11">
  <p class="mb-3.5 font-mono text-[13px] text-accent">// {kicker}</p>
  <div
    data-reveal
    class="flex flex-col items-start gap-3 desk:flex-row desk:items-end desk:justify-between desk:gap-8"
  >
    <h2 class="max-w-[20ch] text-[26px] leading-tight font-bold tracking-[-0.02em] desk:text-[38px]">
      {title}
    </h2>
    {sub && (
      <p class="max-w-[42ch] text-base leading-relaxed text-muted">{sub}</p>
    )}
  </div>
</div>
