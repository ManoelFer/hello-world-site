---
import type { HTMLAttributes } from "astro/types"

interface Props extends HTMLAttributes<"a"> {
  variant?: "primary" | "ghost"
  size?: "md" | "lg"
}

const {
  variant = "primary",
  size = "md",
  class: className,
  ...rest
} = Astro.props

const variants = {
  primary: "bg-accent font-bold text-on-accent hover:bg-accent-hover",
  ghost:
    "border border-line-strong font-semibold text-text hover:border-accent",
}
const sizes = {
  md: "rounded-[11px] px-[18px] py-[11px] text-sm",
  lg: "rounded-xl px-6 py-[15px] text-[15px]",
}
---

<a
  class:list={[
    "inline-flex items-center justify-center gap-2.5 whitespace-nowrap no-underline transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
    variants[variant],
    sizes[size],
    className,
  ]}
  {...rest}
>
  <slot />
</a>
