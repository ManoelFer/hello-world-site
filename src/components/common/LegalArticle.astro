---
interface Props {
  title: string
  updated: string
}

const { title, updated } = Astro.props
---

<article class="mx-auto max-w-3xl px-5 py-14 desk:px-10 desk:py-20 [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-4 [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-text [&_li]:mt-2 [&_p]:mt-4 [&_p]:leading-[1.75] [&_strong]:text-text [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:leading-[1.7] text-[16px] text-soft">
  <h1 class="text-[30px] leading-tight font-bold tracking-[-0.02em] text-text desk:text-[38px]">
    {title}
  </h1>
  <p class="font-mono text-xs text-label">{updated}</p>
  <slot />
</article>
